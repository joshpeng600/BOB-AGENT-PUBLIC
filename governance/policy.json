{
  "schema_version": 2,
  "epsilon": 0.002,
  "consecutive_no_improve": 3,
  "max_single_round_seconds": 3600,
  "automatic_repair": {
    "max_attempts": 1,
    "allowed_for": [
      "allowlisted_transient_infrastructure_failure"
    ],
    "forbidden_for": [
      "missing_dependency_or_environment_change",
      "policy_violation",
      "test_access",
      "data_leakage",
      "dirty_worktree",
      "protected_hash_mismatch",
      "nan_or_infinite_output",
      "metric_regression",
      "scientific_failure_or_change"
    ],
    "requires_identical_retry_inputs": [
      "commit_sha",
      "experiment_spec_hash",
      "config_hash",
      "data_hash",
      "seed",
      "command"
    ],
    "automatic_dependency_install_allowed": false,
    "missing_dependency_action": "write_failed_manifest_and_stop"
  },
  "human_decision_required_when": [
    "protected_file_missing_or_hash_mismatch",
    "test_access_requested_or_detected",
    "three_consecutive_non_improving_trials",
    "automatic_repair_exhausted",
    "run_exceeds_max_single_round_seconds",
    "baseline_or_task_contract_conflict",
    "missing_full_commit_sha_or_dirty_worktree",
    "suspected_data_leakage",
    "role_or_ownership_conflict",
    "history_rewrite_or_force_push_requested"
  ],
  "improvement_rule": {
    "expression": "candidate_primary - baseline_primary > epsilon",
    "strict": true,
    "baseline_primary": 0.603871007132627,
    "candidate_must_be_greater_than": 0.605871007132627
  },
  "test_evaluation": {
    "ordinary_experiments_allowed": false,
    "release_only": true,
    "requires_human_approval": true,
    "requires_manual_intervention_record": true
  }
}
